# Lo que lee el servicio. Copia este archivo a .env y ajusta los valores: .env no se versiona.
# Con la imagen: docker run --env-file .env -p 8080:8080 <imagen>

# El puerto HTTP. 8080 es el que expone la imagen del toolchain.
SERVER_PORT=8080

# El endpoint OTLP de un colector, como http://otel-collector:4318. Vacío, el servicio no exporta nada.
NOVA_OBSERVABILITY_OTLP_ENDPOINT=
